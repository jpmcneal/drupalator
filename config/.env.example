# Multi-Site Security Review — environment config
# Copy to config/.env and edit. config/.env is gitignored.

# Working directory:
# Set it to your Drupal project root or wherever drush aliases are resolved from,
# not the Drupalator install directory. If Drush is installed globally, use `.`
DRUPALATOR_WORKING_DIR=/path/to/drupal/or/drush

# Drush command prefix:
# Required if Drush needs a prefix. For example, if you invoke Drush like this: `ddev drush`,
# then 'ddev' is your prefix.
DRUSH_PREFIX=''

# Drush command syntax:
# 'default' is standard: `drush @mysite.dev status`
# 'alternate' leads with the alias: `@mysite.dev drush status`
DRUSH_SYNTAX='default'

# Reports output directory:
# defaults to $DRUPALATOR_WORKING_DIR/reports if unset
DRUPALATOR_REPORTS_DIR=/path/to/drupalator/output

# Cache directory for drupal.org XML + KEV catalog:
DRUPALATOR_CACHE_DIR=/tmp/drupal_update_cache

# Path to sites.json (relative to repo root, or absolute)
DRUPALATOR_SITES_FILE=config/sites.json

# Install-wide default report theme: must match an existing themes/<name>.css
# file (default is base.css only, no override). A customer's own "theme" key
# in sites.json takes precedence over this. See README "Report themes".
# DRUPALATOR_THEME=

# Email backend: sendmail | msmtp | stdout-eml | gws
DRUPALATOR_EMAIL_BACKEND=stdout-eml

# Email signature appended to draft body
DRUPALATOR_EMAIL_SIGNATURE=Your Friendly Neighborhood Security Team

# Email recipient — required for sendmail/msmtp backends
DRUPALATOR_EMAIL_TO=customer@acme.com

# Optional From address for sendmail/msmtp
DRUPALATOR_EMAIL_FROM=me@example.dev

# Optional binary path overrides
DRUPALATOR_SENDMAIL_BIN=
DRUPALATOR_MSMTP_BIN=
DRUPALATOR_MSMTP_ACCOUNT=
